# Database URL for PostgreSQL (replace with production host/credentials)
DATABASE_URL=postgresql://postgres:postgres@db:5432/clinicos?schema=public

# Redis Connection URL
REDIS_URL=redis://redis:6379

# Production Secrets (Must be changed in production deployments!)
JWT_SECRET=your-production-jwt-secret-key
ENCRYPTION_KEY=your-production-encryption-scrypt-key

# Storage path for uploads
STORAGE_PATH=/usr/src/app/uploads

# Port mapping for NestJS backend
PORT=3001

# Public Frontend API Endpoints (accessible by clients/browsers)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Environment setting
NODE_ENV=production

# Initial seed credentials (required if NODE_ENV=production)
INITIAL_DOCTOR_EMAIL=doctor@clinicios.com
INITIAL_DOCTOR_PASSWORD=your-secure-doctor-password
INITIAL_RECEPTIONIST_EMAIL=receptionist@clinicios.com
INITIAL_RECEPTIONIST_PASSWORD=your-secure-receptionist-password
