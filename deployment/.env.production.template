# ==============================================================================
# ClinicOS Production Staging Environment Template
# ==============================================================================
# Copy this file to .env and configure all variables before launching.
# SECURITY WARNING: DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=clinicos_admin
DB_PASSWORD=SecureProductionDbPassword2026!   # CHANGE THIS TO A STRONG PASSWORD
DB_NAME=clinicos

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
# Default Redis URL matches container name inside docker network
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. Backend Hardening Settings (NestJS)
# ------------------------------------------------------------------------------
# Port the backend container will listen on inside the host
PORT=3001
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=Secure32CharJwtSecretKeyTokenString2026!  # CHANGE THIS TO A SECURE STRING

# Cryptographic Master Key for field-level encryption (Aadhaar data)
ENCRYPTION_KEY=MasterAesKeyForDataEncryptionAtRest  # CHANGE THIS (Must be 32 chars)

# Persistent file storage path
STORAGE_PATH=uploads

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Next.js & Vite)
# ------------------------------------------------------------------------------
# Public API mappings (Accessible from the user's browser)
NEXT_PUBLIC_API_URL=https://staging.clinicos.internal/api
NEXT_PUBLIC_WS_URL=https://staging.clinicos.internal

# ------------------------------------------------------------------------------
# 5. Monitoring & Telemetry Settings
# ------------------------------------------------------------------------------
# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=SecureGrafanaAdminPass2026!    # CHANGE THIS

# Sentry DSN integration tokens
BACKEND_SENTRY_DSN=https://sentry-token@o0000.ingest.sentry.io/0000000000000000
FRONTEND_SENTRY_DSN=https://sentry-token@o0000.ingest.sentry.io/0000000000000000
